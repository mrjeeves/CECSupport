{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CEC Support",
  "identifier": "direct.cec.support",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1432",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CEC Support",
        "width": 980,
        "height": 660,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Critical Error Computing",
    "category": "Utility",
    "shortDescription": "Remote help by support number from Critical Error Computing.",
    "externalBin": [
      "binaries/myownmesh",
      "binaries/allmystuff-serve",
      "binaries/amst"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["rclone", "fuse3"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
